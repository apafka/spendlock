# Which chain: local | base-sepolia | base   <- the ONE switch
NETWORK=local

# Only needed for base-sepolia / base. NEVER commit real keys. NEVER paste them in chat.
# Use 4 separate fresh wallets, each holding only small amounts.
RPC_URL=
DEPLOYER_PRIVATE_KEY=
CLIENT_PRIVATE_KEY=
WORKER_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=
VERIFIER_ADDRESS=
FEE_RECIPIENT=

# Brakes (Spendlock). On-chain cap per job, and a client-side cap per script run.
FEE_BPS=200
MAX_JOB_BUDGET_USDC=20
MAX_SPEND_USDC=20

# PUBLIC addresses of the same 4 accounts (safe to share; used by checklist.js and the web page)
DEPLOYER_ADDRESS=
CLIENT_ADDRESS=
WORKER_ADDRESS=

# Spendlock vault (only for node checklist.js --spendlock / deploy-spendlock.js on base-sepolia).
# OWNER funds the vault and sets the rules; AGENT_A spends under them. Fresh, small wallets only.
OWNER_PRIVATE_KEY=
AGENT_A_PRIVATE_KEY=
OWNER_ADDRESS=
AGENT_A_ADDRESS=
