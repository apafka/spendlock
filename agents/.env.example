# Copy to agents/.env for local / Base Sepolia only.
# Never commit real keys. Never point this at mainnet.

# local | base-sepolia
NETWORK=local
SPENDLOCK_RPC=http://127.0.0.1:8545

# Set after `forge script script/Deploy.s.sol --broadcast` (local) or a Sepolia deploy.
SPENDLOCK_VAULT=

# Owner key for spendlock-owner.js. For local anvil, use a *fresh* test key you control
# in your own .env — do not paste production keys. This file is an example only.
OWNER_PRIVATE_KEY=

# Agent key for the MCP server. One agent process = one key = one onchain policy.
SPENDLOCK_AGENT_KEY=
